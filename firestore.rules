rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Hàm dùng chung ----------
    function signedIn() { return request.auth != null; }
    function myDoc() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && myDoc().role == 'admin'; }
    function isActive() { return hasProfile() && myDoc().status == 'active'; }
    function isGuest() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function regMode() {
      return exists(/databases/$(db)/documents/settings/app)
        ? get(/databases/$(db)/documents/settings/app).data.get('registerMode', 'open') : 'open';
    }

    // ---------- Cài đặt & lớp: ai cũng đọc được, chỉ admin sửa ----------
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /classes/{id}  { allow read: if true; allow write: if isAdmin(); }

    // ---------- Hồ sơ người dùng ----------
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Tự đăng ký: chỉ được tạo hồ sơ "user", trạng thái đúng theo chế độ đăng ký
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid && !isGuest()
        && request.resource.data.role == 'user'
        && regMode() != 'closed'
        && request.resource.data.status == (regMode() == 'approval' ? 'pending' : 'active'));
      // Người dùng chỉ được sửa tên hiển thị và dấu hiệu trực tuyến của chính mình
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'lastLogin', 'displayName']));
      allow delete: if isAdmin();
    }
    // Mật khẩu admin cấp ban đầu (để đổi hộ). Chỉ admin đọc; học viên được xóa khi tự đổi mật khẩu.
    match /userSecrets/{uid} {
      allow read, write: if isAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Thư mục, đề, câu hỏi ----------
    match /folders/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /quizzes/{id} {
      allow read: if isAdmin() || isActive() || (isGuest() && resource.data.guest == true);
      allow write: if isAdmin();
    }
    match /quizContent/{id} {
      allow read: if isAdmin() || isActive()
        || (isGuest() && get(/databases/$(db)/documents/quizzes/$(id)).data.guest == true);
      allow write: if isAdmin();
    }

    // ---------- Bài làm ----------
    match /attempts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && (isActive() || isGuest());
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'in_progress');
      allow delete: if isAdmin();
    }
  }
}
